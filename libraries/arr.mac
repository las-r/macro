// macro array library example
// based off micro array library example
// by las-r

func range(m, n)
    r = []
    i = m
    while i < n
        r = add(r, len(r), i)
        i = i + 1
    end
    return r
end

func slice(a, s, e)
    if s < 0
        s = 0
    end
    if e > len(a)
        e = len(a)
    end
    r = []
    while s < e
        r = add(r, len(r), a:s)
        s = s + 1
    end
    return r
end

func concat(a, b)
    for x, b
        a = add(a, len(a), x)
    end
    return a
end

func rev(a)
    r = []
    for x, a
        r = add(r, 0, x)
    end
    return r
end

func indexof(a, x)
    i = 0
    for y, a
        if y == x
            return i
        end
        i = i + 1
    end
    return -1
end

func has(a, x)
    return indexof(a, x) >= 0
end

func sum(a)
    r = 0
    for x, a
        r = r + x
    end
    return r
end

func amin(a)
    r = a:0
    for x, a
        if x < r
            r = x
        end
    end
    return r
end

func amax(a)
    r = a:0
    for x, a
        if x > r
            r = x
        end
    end
    return r
end

func sortf(a, f)
    i = 1
    while i < len(a)
        x = a:i
        k = f(x)
        j = i - 1
        while (j >= 0) && (f(a:j) > k)
            a:(j + 1) = a:j
            j = j - 1
        end
        a:(j + 1) = x
        i = i + 1
    end
    return a
end

func sort(a)
    return sortf(a, @(x) return x end)
end

func map(a, f)
    r = []
    for x, a
        r = add(r, len(r), f(x))
    end
    return r
end

func filter(a, f)
    r = []
    for x, a
        if f(x)
            r = add(r, len(r), x)
        end
    end
    return r
end

func reduce(a, f, x)
    for y, a
        x = f(x, y)
    end
    return x
end

func zip(a, b)
    if len(a) < len(b)
        l = len(a)
    else
        l = len(b)
    end
    out = []
    i = 0
    while i < l
        out = add(out, len(out), [a:i, b:i])
        i = i + 1
    end
    return out
end
